  "properties": {
    "computed_at": {
      "format": "date-time",
      "pattern": "(?:\\+01:00|\\+02:00)$",
      "type": "string"
    },
    "dependency_id": {
      "format": "uuid",
      "type": "string"
    },
    "dependency_set_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "fact_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "fact_id": {
            "format": "uuid",
            "type": "string"
          },
          "fact_type": {
            "enum": [
              "calculation_instant",
              "tax_year",
              "avs_eligibility_confirmed",
              "lpp_active_confirmed",
              "credited_contributions",
              "provider_inventory_complete",
              "full_year_lausanne_domicile",
              "ordinary_full_year_liability",
              "civil_status_single",
              "dependants_count",
              "ifd_taxable_income_pre_3a_chf",
              "vd_taxable_income_pre_3a_chf",
              "liquid_assets_chf",
              "selected_emergency_buffer_chf",
              "debts_due_90d_chf",
              "essential_expenses_30d_chf",
              "monthly_surplus_chf",
              "overdue_debt_present",
              "maximum_debt_apr_percent"
            ]
          },
          "fact_version": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "fact_id",
          "fact_version",
          "fact_type"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "key_contract_ref": {
      "const": "unresolved"
    },
    "owner_id": {
      "format": "uuid",
      "type": "string"
    },
    "owner_type": {
      "enum": [
        "result",
        "plan3a"
      ]
    },
    "privacy_contract_ref": {
      "const": "unresolved"
    },
    "profile": {
      "enum": [
        "plan_affordability",
        "plan_economic_effort",
        "result"
      ]
    },
    "record_type": {
      "const": "mint_next_3a_dependency"
    },
    "record_version": {
      "minimum": 1,
      "type": "integer"
    },
    "retention_contract_ref": {
      "const": "unresolved"
    },
    "ruleset": {
      "additionalProperties": false,
      "properties": {
        "ruleset_id": {
          "const": "three_a_lausanne_2026"
        },
        "ruleset_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "ruleset_id",
        "ruleset_sha256"
      ],
      "type": "object"
    },
    "schema_id": {
      "const": "mint_next_3a_dependency_record"
    },
    "schema_version": {
      "const": 1
    },
    "stale_at": {
      "format": "date-time",
      "pattern": "(?:\\+01:00|\\+02:00)$",
      "type": "string"
    },
    "stale_reason": {
      "enum": [
        "fact_superseded",
        "fact_revoked",
        "fact_deleted",
        "fact_expired",
        "event_invalidated",
        "ruleset_changed",
        "schema_migrated",
        "dependency_missing",
        "conflict"
      ]
    },
    "status": {
      "enum": [
        "live",
        "stale"
      ]
    },
    "subject_local_id": {
      "format": "uuid",
      "type": "string"
    }
  },
  "title": "MINT Next 3a DependencyRecord v1",
  "type": "object",
  "x-mint-contract": {
    "activation": "OFF",
    "canonical_order": "fact_type_then_fact_id_then_version",
    "canonicalization_algorithm": "rfc8785_embedded_v1",
    "contains_financial_values": false,
    "contract_id": "three_a_dependency_record_v1",
    "decision": "STOP",
    "dependency_set_hash_algorithm": "sha256_over_rfc8785_embedded_v1_fact_refs_plus_ruleset",
    "does_not_close_B0": true,
    "duplicates_forbidden": true,
    "fact_ref_format": "fact_id@fact_version",
    "phase_status": "pre_activation",
    "real_user_exposure": "forbidden",
    "runtime_implemented": false,
    "silent_recompute": false,
    "stale_synchronously": true,
    "temporal_order": [
      "max(referenced_fact.availability_at)<=computed_at"
    ],
    "third_store": false
  }
}
