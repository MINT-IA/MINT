              '    final hasNoOldAgeBenefit =\r\n'
              '        input.self.entitlement != AvsPensionEntitlement.oldAge &&\r\n'
              '            input.partner.entitlement != AvsPensionEntitlement.oldAge;\r\n'
              '    final bothDisability =\r\n'
              '        input.self.entitlement == AvsPensionEntitlement.disability &&\r\n'
              '            input.partner.entitlement == AvsPensionEntitlement.disability;\r\n'
              '    if (bothDisability) {\r\n'
              '      final legalStatus = input.legalStatus;\r\n'
              '      if (legalStatus == null) {\r\n'
              '        missing.add(\'legalStatus\');\r\n'
              '      } else if (legalStatus == AvsCoupleLegalStatus.married ||\r\n'
              '          legalStatus == AvsCoupleLegalStatus.registeredPartnership) {\r\n'
