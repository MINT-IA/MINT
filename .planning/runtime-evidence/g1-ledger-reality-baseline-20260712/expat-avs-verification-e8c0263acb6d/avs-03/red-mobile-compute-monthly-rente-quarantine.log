              '\r\n'
              '  static const int coupleLegalYear = 2026;\r\n'
              '  static const String coupleLegalSource =\r\n'
              '      \'LAVS art. 35; RAVS art. 52; RAVS art. 53; RAVS art. 53bis; \'\r\n'
              '      \'RAVS art. 53ter; \'\r\n'
              '      \'OFAS 2026 pension amounts\';\r\n'
              '\r\n'
              '  /// Compute individual AVS monthly rente.\r\n'
              '  ///\r\n'
              '  /// Takes into account:\r\n'
              '  /// - Contribution duration (lacunes, arrivalAge) — LAVS art. 29\r\n'
              '  /// - Income level via RAMD proxy — LAVS art. 34, echelle 44\r\n'
              '  /// - Early retirement penalty (6.8%/yr from 63) — LAVS art. 40\r\n'
              '  /// - Deferral bonus (up to +31.5% at 70) — LAVS art. 39\r\n'
              '  /// - Gender-aware reference age for AVS21 (LAVS art. 21 al. 1)\r\n'
              '  /// - Child-raising credits (bonifications éducatives) — LAVS art. 29sexies\r\n'
              '  ///\r\n'
              '  /// This illustration does not perform LAVS art. 29quinquies splitting.\r\n'
              '  /// Exact splitting needs year-by-year individual-account histories and a\r\n'
              '  /// statutory trigger; current salaries and marriage duration are rejected as\r\n'
              '  /// a substitute by the couple legal contract.\r\n'
              '  ///\r\n'
              '  /// [isFemale] and [birthYear] are optional — when provided, the\r\n'
              '  /// reference age accounts for AVS21 transitional cohorts (women\r\n'
              '  /// born 1961-1963). When omitted, defaults to 65 (male/unknown).\r\n'
              '  static double computeMonthlyRente({\r\n'
              '    required int currentAge,\r\n'
              '    required int retirementAge,\r\n'
              '    int lacunes = 0,\r\n'
              '    int? anneesContribuees,\r\n'
              '    int? arrivalAge,\r\n'
              '    double grossAnnualSalary = 0,\r\n'
              '    bool? isFemale,\r\n'
              '    int? birthYear,\r\n'
              '    int childRaisingYears = 0,\r\n'
              '    int totalContributionYears = avsDureeCotisationComplete,\r\n'
              '  }) {\r\n'
              '    // Determine gender-aware reference age (AVS21, LAVS art. 21 al. 1)\r\n'
              '    final refAge = (isFemale != null && birthYear != null)\r\n'
              '        ? avsReferenceAgeYears(birthYear: birthYear, isFemale: isFemale)\r\n'
              '        : reg(\'avs.reference_age_men\', avsAgeReferenceHomme.toDouble());\r\n'
              '\r\n'
              '    // 1. Contribution years\r\n'
              '    final fullYears = reg(\'avs.full_contribution_years\', avsDureeCotisationComplete.toDouble()).toInt();\r\n'
              '\r\n'
              '    int currentYears;\r\n'
              '    if (anneesContribuees != null) {\r\n'
              '      currentYears = anneesContribuees;\r\n'
              '    } else if (arrivalAge != null && arrivalAge > 20) {\r\n'
              '      currentYears =\r\n'
              '          (currentAge - arrivalAge).clamp(0, fullYears);\r\n'
              '    } else {\r\n'
              '      currentYears =\r\n'
              '          (currentAge - 20).clamp(0, fullYears);\r\n'
              '    }\r\n'
              '    final futureYears = (retirementAge - currentAge).clamp(0, 50);\r\n'
              '    final totalYears =\r\n'
              '        (currentYears + futureYears).clamp(0, fullYears);\r\n'
              '    final effectiveYears =\r\n'
              '        (totalYears - lacunes).clamp(0, fullYears);\r\n'
              '    final gapFactor = fullYears > 0 ? effectiveYears / fullYears : 0.0;\r\n'
              '\r\n'
              '    // 2. Effective salary (RAMD) with child credits\r\n'
              '    double effectiveSalary = grossAnnualSalary;\r\n'
              '\r\n'
              '    // 2a. Child-raising credits / bonifications éducatives (LAVS art. 29sexies)\r\n'
              '    // Annual credit = 3× minimum annual AVS pension.\r\n'
              '    // Added to RAMD prorated over total contribution years.\r\n'
              '    if (childRaisingYears > 0 && totalContributionYears > 0) {\r\n'
              '      const bonificationAnnuelle = 3 * avsRenteMinMensuelle * 12;\r\n'
              '      final bonificationRAMD =\r\n'
              '          (bonificationAnnuelle * childRaisingYears) / totalContributionYears;\r\n'
              '      effectiveSalary += bonificationRAMD;\r\n'
              '      effectiveSalary = effectiveSalary.clamp(0, avsRAMDMax);\r\n'
              '    }\r\n'
              '\r\n'
              '    // 2b. RAMD-based rente (LAVS art. 34, echelle 44)\r\n'
              '    final baseRente = renteFromRAMD(effectiveSalary);\r\n'
              '    double rente = baseRente * gapFactor;\r\n'
              '\r\n'
              '    // 3. Early/late retirement adjustments relative to gender-aware refAge\r\n'
              '    if (retirementAge < 63) {\r\n'
              '      // AVS anticipation only possible from 63 (LAVS art. 40)\r\n'
              '      return 0.0;\r\n'
              '    } else if (retirementAge < refAge) {\r\n'
              '      final yearsEarly = refAge - retirementAge;\r\n'
              '      rente *= (1.0 - reg(\'avs.anticipation_reduction\', avsReductionAnticipation) * yearsEarly);\r\n'
              '    } else if (retirementAge > refAge) {\r\n'
              '      final yearsLate = (retirementAge - refAge).clamp(1, 5).round();\r\n'
              '      final bonus = avsDeferralBonus[yearsLate] ?? avsDeferralBonus[5]!;\r\n'
              '      rente *= (1.0 + bonus);\r\n'
              '    }\r\n'
              '\r\n'
              '    return rente;\r\n'
              '  }\r\n'
              '\r\n'
              '  /// Round to nearest 5 centimes (Swiss standard for social insurance amounts).\r\n'
              '  /// OAVS art. 53 — applied at display level, not computation level,\r\n'
              '  /// to avoid cascading rounding effects in couple/optimizer calculations.\r\n'
              '  static double roundTo5Centimes(double value) {\r\n'
              '    return (value * 20).roundToDouble() / 20;\r\n'
              '  }\r\n'
              '\r\n'
              '  /// Position the self-employed AVS/AI/APG barème gauge.\r\n'
              '  ///\r\n'
              '  /// `1.0` means the income has reached the full-rate bracket for independent\r\n'
              '  /// AVS cotisations. Keep this threshold in financial_core so screens render\r\n'
              '  /// calculator output instead of owning financial constants.\r\n'
              '  static double selfEmployedCotisationGaugePosition(double revenuNet) {\r\n'
              '    final fullRateThreshold =\r\n'
              '        reg(\'avs.self_employed_full_rate_threshold\', 60500.0);\r\n'
              '    if (revenuNet <= 0 || fullRateThreshold <= 0) return 0.0;\r\n'
              '    return (revenuNet / fullRateThreshold).clamp(0.0, 1.0).toDouble();\r\n'
              '  }\r\n'
              '\r\n'
              '  /// AVS rente based on RAMD using Echelle 44 (LAVS art. 34).\r\n'
              '  ///\r\n'
              '  /// Concave lookup + linear interpolation between table points.\r\n'
              '  /// Source: Memento 6.01 — Tables des rentes AVS/AI (OFAS 2025).\r\n'
              '  /// RAMD <= 0 → 0 (no salary data).\r\n'
              '  /// RAMD <= 14\'700 → 1\'260/mois (minimum).\r\n'
              '  /// RAMD >= 88\'200 → 2\'520/mois (maximum).\r\n'
              '  /// Between table points: linear interpolation within the bracket.\r\n'
              '  /// gapFactor in computeMonthlyRente already handles contribution years.\r\n'
              '  static double renteFromRAMD(double grossAnnualSalary) {\r\n'
              '    if (grossAnnualSalary <= 0) return 0;\r\n'
              '    final table = RegulatorySyncService.getEchelle44();\r\n'
              '    if (grossAnnualSalary <= table.first[0]) return table.first[1];\r\n'
              '    if (grossAnnualSalary >= table.last[0]) return table.last[1];\r\n'
              '    for (int i = 0; i < table.length - 1; i++) {\r\n'
              '      final lower = table[i];\r\n'
              '      final upper = table[i + 1];\r\n'
              '      if (grossAnnualSalary >= lower[0] && grossAnnualSalary <= upper[0]) {\r\n'
              '        final ratio = (grossAnnualSalary - lower[0]) / (upper[0] - lower[0]);\r\n'
              '        return lower[1] + ratio * (upper[1] - lower[1]);\r\n'
              '      }\r\n'
              '    }\r\n'
              '    return table.last[1];\r\n'
              '  }\r\n'
              '\r\n'
              '  /// Apply the LAVS art. 35 / RAVS arts. 53bis-53ter couple contract.\r\n'
              '  ///\r\n'
              '  /// This accepts only person-owned ordinary pensions. Missing or invalid\r\n'
              '  /// legal evidence returns [AvsCoupleCapState.pending] and no complete\r\n'
              '  /// household amount. It never derives a pension from salary, age, or a\r\n'
              '  /// default scale.\r\n'
              '  static AvsCouplePensionResult computeCouplePensions(\r\n'
              '    AvsCouplePensionInput input,\r\n'
              '  ) {\r\n'
              '    final missing = <String>[];\r\n'
              '\r\n'
              '    final aggregationMissing = <String>[];\r\n'
              '    _appendMissingBasePersonFields(\r\n'
              '      input.self,\r\n'
              '      AvsPersonRole.self,\r\n'
              '      aggregationMissing,\r\n'
              '    );\r\n'
              '    _appendMissingBasePersonFields(\r\n'
              '      input.partner,\r\n'
              '      AvsPersonRole.partner,\r\n'
              '      aggregationMissing,\r\n'
              '    );\r\n'
              '    missing.addAll(aggregationMissing);\r\n'
              '\r\n'
              '    final rawHousehold = aggregationMissing.isEmpty\r\n'
              '        ? [_activeRawPension(input.self), _activeRawPension(input.partner)]\r\n'
              '            .whereType<double>()\r\n'
              '            .fold<double>(0, (sum, value) => sum + value)\r\n'
              '        : null;\r\n'
              '\r\n'
              '    final capBenefitCombination =\r\n'
