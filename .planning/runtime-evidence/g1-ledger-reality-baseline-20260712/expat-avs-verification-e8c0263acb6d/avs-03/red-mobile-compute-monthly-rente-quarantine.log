              '      missing.add(\'legalStatus\');\r\n'
              '    }\r\n'
              '    final marriageEquivalent =\r\n'
              '        input.legalStatus == AvsCoupleLegalStatus.married ||\r\n'
              '            input.legalStatus == AvsCoupleLegalStatus.registeredPartnership;\r\n'
              '    if (marriageEquivalent && capBenefitCombination) {\r\n'
              '      final separation = input.judicialSeparation;\r\n'
              '      if (separation == null) {\r\n'
              '        missing.add(\'judicialSeparation\');\r\n'
              '      } else if (separation.source.trim().isEmpty) {\r\n'
              '        missing.add(\'judicialSeparation.source\');\r\n'
              '      } else if (!separation.isSeparated) {\r\n'
              '        _appendMissingCapFields(input.self, AvsPersonRole.self, missing);\r\n'
              '        _appendMissingCapFields(\r\n'
              '          input.partner,\r\n'
              '          AvsPersonRole.partner,\r\n'
              '          missing,\r\n'
              '        );\r\n'
              '      }\r\n'
              '    }\r\n'
              '\r\n'
              '    if (missing.isNotEmpty) {\r\n'
              '      final separationSource = input.judicialSeparation?.source;\r\n'
              '      return _coupleResult(\r\n'
              '        input: input,\r\n'
