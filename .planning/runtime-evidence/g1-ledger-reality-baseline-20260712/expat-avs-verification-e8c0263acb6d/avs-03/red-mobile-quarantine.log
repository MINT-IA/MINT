              '    } else if (retirementAge > refAge) {\r\n'
              '      final yearsLate = (retirementAge - refAge).clamp(1, 5).round();\r\n'
              '      final bonus = avsDeferralBonus[yearsLate] ?? avsDeferralBonus[5]!;\r\n'
              '      rente *= (1.0 + bonus);\r\n'
              '    }\r\n'
              '\r\n'
              '    return rente;\r\n'
              '  }\r\n'
              '\r\n'
              '  /// Round to nearest 5 centimes (Swiss standard for social insurance amounts).\r\n'
              '  /// OAVS art. 53 — applied at display level, not computation level,\r\n'
              '  /// to avoid cascading rounding effects in couple/optimizer calculations.\r\n'
              '  static double roundTo5Centimes(double value) {\r\n'
              '    return (value * 20).roundToDouble() / 20;\r\n'
              '  }\r\n'
              '\r\n'
              '  /// Position the self-employed AVS/AI/APG barème gauge.\r\n'
