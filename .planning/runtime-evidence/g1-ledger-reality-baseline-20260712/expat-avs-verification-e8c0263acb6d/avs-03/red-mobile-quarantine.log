              '    \'VD\': 1000000.0,  // LI-VD art. 60\r\n'
              '    \'GE\': 600000.0,   // LIPP-GE art. 15\r\n'
              '    \'VS\': 250000.0,   // LF-VS art. 12\r\n'
              '    \'ZG\': 500000.0,   // StG-ZG § 12\r\n'
              '    \'FR\': 400000.0,   // LICD-FR art. 12\r\n'
              '    \'LU\': 400000.0,   // StG-LU § 14 (base fédérale)\r\n'
              '    \'BE\': 400000.0,   // StG-BE art. 14\r\n'
              '    \'NE\': 500000.0,   // LCdir-NE art. 14\r\n'
              '    \'TI\': 400000.0,   // LT-TI art. 7 (base fédérale)\r\n'
              '    \'GR\': 400000.0,   // StG-GR art. 11\r\n'
              '    \'SG\': 400000.0,   // StG-SG art. 12\r\n'
              '    \'TG\': 400000.0,   // StG-TG § 12\r\n'
              '    \'AG\': 400000.0,   // StG-AG § 12\r\n'
              '    \'SO\': 400000.0,   // StG-SO § 11\r\n'
              '    \'OW\': 400000.0,   // StG-OW art. 12 (base fédérale)\r\n'
              '    \'NW\': 400000.0,   // StG-NW art. 12 (base fédérale)\r\n'
              '    \'GL\': 400000.0,   // StG-GL art. 12 (base fédérale)\r\n'
              '    \'UR\': 400000.0,   // StG-UR art. 12 (base fédérale)\r\n'
              '    \'SZ\': 400000.0,   // StG-SZ § 12\r\n'
              '    \'JU\': 400000.0,   // LI-JU art. 12\r\n'
              '    // Abolished:\r\n'
              '    \'ZH\': null,\r\n'
              '    \'SH\': null,\r\n'
              '    \'AR\': null,\r\n'
              '    \'AI\': null,\r\n'
              '    \'BS\': null,\r\n'
              '    \'BL\': null,\r\n'
              '  };\r\n'
              '\r\n'
              '  /// Cantons where forfait is abolished.\r\n'
              '  static const Set<String> forfaitAbolishedCantons = {\r\n'
              '    \'ZH\', \'SH\', \'AR\', \'AI\', \'BS\', \'BL\',\r\n'
              '  };\r\n'
              '\r\n'
              '  /// List of eligible cantons for forfait (sorted).\r\n'
              '  static List<String> get eligibleForfaitCantons {\r\n'
              '    final eligible = forfaitMinimumByCanton.entries\r\n'
              '        .where((e) => e.value != null)\r\n'
              '        .map((e) => e.key)\r\n'
              '        .toList()\r\n'
              '      ..sort();\r\n'
              '    return eligible;\r\n'
              '  }\r\n'
              '\r\n'
              '  // ════════════════════════════════════════════════════════════\r\n'
              '  //  AVS VOLUNTARY ABROAD\r\n'
              '  // ════════════════════════════════════════════════════════════\r\n'
              '\r\n'
              '  /// AVS voluntary minimum contribution per year.\r\n'
              '  static double get avsVoluntaryMin => reg(\'avs.voluntary_min\', avsVolontaireCotisationMin);\r\n'
              '\r\n'
              '  /// AVS voluntary maximum contribution per year.\r\n'
              '  static double get avsVoluntaryMax => reg(\'avs.voluntary_max\', avsVolontaireCotisationMax);\r\n'
              '\r\n'
              '  /// Rente reduction per missing year (~2.3% per year on 44 years).\r\n'
              '  static double get reductionPerMissingYear => 1.0 / reg(\'avs.full_contribution_years\', avsDureeCotisationComplete.toDouble());\r\n'
              '\r\n'
              '  /// Full contribution years for max AVS rente.\r\n'
              '  static int get fullContributionYears => reg(\'avs.full_contribution_years\', avsDureeCotisationComplete.toDouble()).toInt();\r\n'
              '\r\n'
              '  // ════════════════════════════════════════════════════════════\r\n'
              '  //  NEIGHBOURING COUNTRY SOCIAL CHARGES (approx employee share)\r\n'
              '  // ════════════════════════════════════════════════════════════\r\n'
              '\r\n'
              '  /// Source: backend CHARGES_SOCIALES_PAYS (CSS, SGB IV, INPS, ASVG).\r\n'
              '  static const Map<String, Map<String, double>> foreignSocialCharges = {\r\n'
              '    \'France\': {\r\n'
              '      \'maladie\': 0.0000, // CSG/CRDS handled differently\r\n'
              '      \'vieillesse_base\': 0.0690,\r\n'
              '      \'vieillesse_compl\': 0.0400,\r\n'
              '      \'chomage\': 0.0240,\r\n'
              '      \'csg_crds\': 0.0920,\r\n'
              '      \'total\': 0.225,  // ~22.5% (aligned with backend)\r\n'
              '    },\r\n'
              '    \'Allemagne\': {\r\n'
              '      \'krankenversicherung\': 0.0730,\r\n'
              '      \'rentenversicherung\': 0.0930,\r\n'
              '      \'arbeitslosenversicherung\': 0.0130,\r\n'
              '      \'pflegeversicherung\': 0.0260,\r\n'
              '      \'total\': 0.205,  // ~20.5% (aligned with backend)\r\n'
              '    },\r\n'
              '    \'Italie\': {\r\n'
              '      \'inps_pensione\': 0.0700,\r\n'
              '      \'inps_malattia\': 0.0150,\r\n'
              '      \'disoccupazione\': 0.0150,\r\n'
              '      \'total\': 0.10,   // ~10% (aligned with backend)\r\n'
              '    },\r\n'
              '    \'Autriche\': {\r\n'
              '      \'krankenversicherung\': 0.0387,\r\n'
              '      \'pensionsversicherung\': 0.1025,\r\n'
              '      \'arbeitslosenversicherung\': 0.0300,\r\n'
              '      \'wohnbaufoerderung\': 0.0088,\r\n'
              '      \'total\': 0.18,   // ~18% (aligned with backend)\r\n'
              '    },\r\n'
              '  };\r\n'
              '\r\n'
              '  /// Approximate effective tax rates for comparison countries.\r\n'
              '  static const Map<String, double> foreignEffectiveTaxRate = {\r\n'
              '    \'France\': 0.30,\r\n'
              '    \'Allemagne\': 0.35,\r\n'
              '    \'Italie\': 0.38,\r\n'
              '    \'Autriche\': 0.33,\r\n'
              '    \'Portugal\': 0.20,\r\n'
              '    \'Dubai\': 0.00,\r\n'
              '    \'Singapour\': 0.15,\r\n'
              '    \'UK\': 0.32,\r\n'
              '  };\r\n'
              '\r\n'
              '  // ════════════════════════════════════════════════════════════\r\n'
              '  //  CANTON NAMES (French)\r\n'
              '  // ════════════════════════════════════════════════════════════\r\n'
              '\r\n'
              '  static const Map<String, String> cantonNames = {\r\n'
              '    \'ZH\': \'Zurich\',\r\n'
              '    \'BE\': \'Berne\',\r\n'
              '    \'LU\': \'Lucerne\',\r\n'
              '    \'UR\': \'Uri\',\r\n'
              '    \'SZ\': \'Schwyz\',\r\n'
              '    \'OW\': \'Obwald\',\r\n'
              '    \'NW\': \'Nidwald\',\r\n'
              '    \'GL\': \'Glaris\',\r\n'
              '    \'ZG\': \'Zoug\',\r\n'
              '    \'FR\': \'Fribourg\',\r\n'
              '    \'SO\': \'Soleure\',\r\n'
              '    \'BS\': \'Bale-Ville\',\r\n'
              '    \'BL\': \'Bale-Campagne\',\r\n'
              '    \'SH\': \'Schaffhouse\',\r\n'
              '    \'AR\': \'Appenzell RE\',\r\n'
              '    \'AI\': \'Appenzell RI\',\r\n'
              '    \'SG\': \'Saint-Gall\',\r\n'
              '    \'GR\': \'Grisons\',\r\n'
              '    \'AG\': \'Argovie\',\r\n'
              '    \'TG\': \'Thurgovie\',\r\n'
              '    \'TI\': \'Tessin\',\r\n'
              '    \'VD\': \'Vaud\',\r\n'
              '    \'VS\': \'Valais\',\r\n'
              '    \'NE\': \'Neuchatel\',\r\n'
              '    \'GE\': \'Geneve\',\r\n'
              '    \'JU\': \'Jura\',\r\n'
              '  };\r\n'
              '\r\n'
              '  /// Sorted canton codes (alphabetical).\r\n'
              '  static List<String> get sortedCantonCodes {\r\n'
              '    final codes = cantonNames.keys.toList()..sort();\r\n'
              '    return codes;\r\n'
              '  }\r\n'
              '\r\n'
              '  // ════════════════════════════════════════════════════════════\r\n'
              '  //  1. CALCULATE SOURCE TAX (Bareme C)\r\n'
              '  // ════════════════════════════════════════════════════════════\r\n'
              '\r\n'
              '  /// Calculate monthly source tax for a frontalier.\r\n'
              '  ///\r\n'
              '  /// [salary] — gross monthly salary in CHF.\r\n'
              '  /// [canton] — canton of work (2-letter code).\r\n'
              '  /// [isMarried] — married status.\r\n'
              '  /// [children] — number of dependent children.\r\n'
              '  ///\r\n'
              '  /// Returns effective tax, rate, annual total.\r\n'
              '  static Map<String, dynamic> calculateSourceTax({\r\n'
              '    required double salary,\r\n'
              '    required String canton,\r\n'
              '    bool isMarried = false,\r\n'
              '    int children = 0,\r\n'
              '  }) {\r\n'
              '    // Wave 7 edge-case audit P0-E33 : un canton en minuscule ou avec\r\n'
              '    // espace ("ge", "GE ", "Geneva") tombait silencieusement sur le\r\n'
              '    // fallback 13 % au lieu du vrai taux cantonal. resolveCanton()\r\n'
              '    // normalise + valide.\r\n'
              '    final cantonCode = resolveCanton(canton).code;\r\n'
              '    final baseRate = sourceTaxRates[cantonCode] ?? 0.13;\r\n'
              '\r\n'
              '    // TI special case: taxed in Italy, not at source in CH\r\n'
              '    if (cantonCode == \'TI\') {\r\n'
              '      return {\r\n'
              '        \'monthlySalary\': salary,\r\n'
              '        \'canton\': canton,\r\n'
              '        \'cantonNom\': cantonNames[canton] ?? canton,\r\n'
              '        \'monthlyTax\': 0.0,\r\n'
              '        \'effectiveRate\': 0.0,\r\n'
              '        \'annualTax\': 0.0,\r\n'
              '        \'isMarried\': isMarried,\r\n'
              '        \'children\': children,\r\n'
              '        \'isTessin\': true,\r\n'
              '        \'note\': \'Depuis le nouvel accord CH-IT (2024), les frontaliers \'\r\n'
              '            \'travaillant au Tessin sont imposes en Italie. \'\r\n'
              '            \'La Suisse ne preleve pas d\\\'impot a la source.\',\r\n'
              '        \'disclaimer\': disclaimer,\r\n'
              '      };\r\n'
              '    }\r\n'
              '\r\n'
              '    // Married reduction factor (~8%)\r\n'
              '    double marriedFactor = isMarried ? 0.92 : 1.0;\r\n'
              '\r\n'
              '    // Children reduction: ~2.5% per child\r\n'
              '    double childrenFactor = 1.0 - (children * 0.025);\r\n'
              '    childrenFactor = max(0.70, childrenFactor); // floor at 70%\r\n'
              '\r\n'
              '    final effectiveRate = baseRate * marriedFactor * childrenFactor;\r\n'
              '    final monthlyTax = salary * effectiveRate;\r\n'
              '    final annualTax = monthlyTax * 12;\r\n'
              '\r\n'
              '    return {\r\n'
              '      \'monthlySalary\': salary,\r\n'
              '      \'canton\': cantonCode,\r\n'
              '      \'cantonNom\': cantonNames[cantonCode] ?? cantonCode,\r\n'
              '      \'monthlyTax\': monthlyTax,\r\n'
              '      \'effectiveRate\': effectiveRate,\r\n'
              '      \'annualTax\': annualTax,\r\n'
              '      \'baseRate\': baseRate,\r\n'
              '      \'isMarried\': isMarried,\r\n'
              '      \'children\': children,\r\n'
              '      \'isTessin\': false,\r\n'
              '      \'disclaimer\': disclaimer,\r\n'
              '    };\r\n'
              '  }\r\n'
              '\r\n'
              '  // ════════════════════════════════════════════════════════════\r\n'
              '  //  2. CHECK QUASI-RESIDENT ELIGIBILITY\r\n'
              '  // ════════════════════════════════════════════════════════════\r\n'
              '\r\n'
              '  /// Check quasi-resident status (mainly relevant for GE).\r\n'
              '  ///\r\n'
              '  /// If >= 90% of worldwide income is earned in CH, the frontalier\r\n'
              '  /// can request ordinary taxation (with deductions).\r\n'
              '  static Map<String, dynamic> checkQuasiResident({\r\n'
              '    required double chIncome,\r\n'
              '    required double worldwideIncome,\r\n'
              '    required String canton,\r\n'
              '  }) {\r\n'
              '    if (worldwideIncome <= 0) {\r\n'
              '      return {\r\n'
              '        \'eligible\': false,\r\n'
              '        \'ratio\': 0.0,\r\n'
              '        \'potentialSavings\': 0.0,\r\n'
              '        \'canton\': canton,\r\n'
              '        \'disclaimer\': disclaimer,\r\n'
              '      };\r\n'
              '    }\r\n'
              '\r\n'
              '    final ratio = chIncome / worldwideIncome;\r\n'
              '    final eligible = ratio >= quasiResidentThreshold;\r\n'
              '\r\n'
              '    // Potential savings: difference between source tax and ordinary tax\r\n'
              '    // Ordinary tax allows deductions (3a, frais effectifs, etc.)\r\n'
              '    // Rough estimate: ~15-25% savings on source tax\r\n'
              '    double potentialSavings = 0.0;\r\n'
              '    if (eligible) {\r\n'
              '      final sourceRate = sourceTaxRates[canton] ?? 0.13;\r\n'
              '      // Assume ~20% reduction thanks to deductions\r\n'
              '      potentialSavings = chIncome * sourceRate * 0.20;\r\n'
              '    }\r\n'
              '\r\n'
              '    return {\r\n'
              '      \'eligible\': eligible,\r\n'
              '      \'ratio\': ratio,\r\n'
              '      \'ratioPercent\': (ratio * 100),\r\n'
              '      \'threshold\': quasiResidentThreshold * 100,\r\n'
              '      \'chIncome\': chIncome,\r\n'
              '      \'worldwideIncome\': worldwideIncome,\r\n'
              '      \'potentialSavings\': potentialSavings,\r\n'
              '      \'canton\': canton,\r\n'
              '      \'cantonNom\': cantonNames[canton] ?? canton,\r\n'
              '      \'recommendation\': eligible\r\n'
              '          ? \'Tu es éligible au statut de quasi-résident. Cela te permet de \'\r\n'
              '              \'faire une taxation ordinaire avec déductions (3a, frais effectifs, etc.). \'\r\n'
              '              \'L\\\'économie potentielle est estimée à ${formatChf(potentialSavings)}/an.\'\r\n'
              '          : \'Tu n\\\'es pas éligible au statut de quasi-résident. \'\r\n'
              '              \'Il te faudrait que ${(quasiResidentThreshold * 100).toStringAsFixed(0)}% \'\r\n'
              '              \'de tes revenus mondiaux proviennent de Suisse.\',\r\n'
              '      \'disclaimer\': disclaimer,\r\n'
              '    };\r\n'
              '  }\r\n'
              '\r\n'
              '  // ════════════════════════════════════════════════════════════\r\n'
              '  //  3. SIMULATE 90-DAY RULE\r\n'
              '  // ════════════════════════════════════════════════════════════\r\n'
              '\r\n'
              '  /// Simulate the 90-day home office rule for frontaliers.\r\n'
              '  ///\r\n'
              '  /// If a frontalier works more than 90 days/year outside CH,\r\n'
              '  /// the taxation may shift to the country of residence.\r\n'
              '  static Map<String, dynamic> simulate90DayRule({\r\n'
              '    required int homeOfficeDays,\r\n'
              '    required int commuteDays,\r\n'
              '  }) {\r\n'
              '    final totalWorkDays = homeOfficeDays + commuteDays;\r\n'
              '    final riskDays = homeOfficeDays;\r\n'
              '\r\n'
              '    String riskLevel;\r\n'
              '    String riskColor;\r\n'
              '    String recommendation;\r\n'
              '\r\n'
              '    if (riskDays < 70) {\r\n'
              '      riskLevel = \'low\';\r\n'
              '      riskColor = \'green\';\r\n'
              '      recommendation =\r\n'
              '          \'Pas de risque fiscal. Tu es largement sous le seuil de 90 jours. \'\r\n'
              '          \'Tu peux continuer a travailler depuis ton domicile a l\\\'etranger \'\r\n'
              '          \'sans impact sur ton imposition a la source en Suisse.\';\r\n'
              '    } else if (riskDays < 90) {\r\n'
              '      riskLevel = \'medium\';\r\n'
              '      riskColor = \'orange\';\r\n'
              '      recommendation =\r\n'
              '          \'Zone d\\\'attention ! Tu t\\\'approches du seuil de 90 jours. \'\r\n'
              '          \'Il te reste ${90 - riskDays} jours de marge. \'\r\n'
              '          \'Documente bien tes jours de presence au bureau en Suisse.\';\r\n'
              '    } else {\r\n'
              '      riskLevel = \'high\';\r\n'
              '      riskColor = \'red\';\r\n'
              '      recommendation =\r\n'
              '          \'Risque fiscal — l\\\'imposition peut basculer vers ton pays de residence. \'\r\n'
              '          \'Avec $riskDays jours de home office, tu depasses le seuil de 90 jours. \'\r\n'
              '          \'Ton employeur pourrait devoir cotiser dans ton pays de residence. \'\r\n'
              '          \'Consulte un-e spécialiste en fiscalité internationale.\'; // lint-ignore: legacy expat disclaimer catalog\r\n'
              '    }\r\n'
              '\r\n'
              '    return {\r\n'
              '      \'homeOfficeDays\': homeOfficeDays,\r\n'
              '      \'commuteDays\': commuteDays,\r\n'
              '      \'totalWorkDays\': totalWorkDays,\r\n'
              '      \'riskDays\': riskDays,\r\n'
              '      \'riskLevel\': riskLevel,\r\n'
              '      \'riskColor\': riskColor,\r\n'
              '      \'threshold\': ninetyDayRuleThreshold,\r\n'
              '      \'daysRemaining\': max(0, ninetyDayRuleThreshold - riskDays),\r\n'
              '      \'isOverThreshold\': riskDays >= ninetyDayRuleThreshold,\r\n'
              '      \'recommendation\': recommendation,\r\n'
              '      \'legalReference\':\r\n'
              '          \'Art. 15 al. 4 CDI CH-FR / Accord amiable du 22 decembre 2022 / \'\r\n'
              '          \'Reglement CE 883/2004 art. 13\',\r\n'
              '      \'disclaimer\': disclaimer,\r\n'
              '    };\r\n'
              '  }\r\n'
              '\r\n'
              '  // ════════════════════════════════════════════════════════════\r\n'
              '  //  4. COMPARE SOCIAL CHARGES\r\n'
              '  // ════════════════════════════════════════════════════════════\r\n'
              '\r\n'
              '  /// Compare Swiss social charges vs a neighbouring country.\r\n'
              '  static Map<String, dynamic> compareSocialCharges({\r\n'
              '    required double salary,\r\n'
              '    required String residenceCountry,\r\n'
              '  }) {\r\n'
              '    final annualSalary = salary * 12;\r\n'
              '\r\n'
              '    // ── CH charges ──\r\n'
              '    final chAvs = annualSalary * avsAiApgRate;\r\n'
              '    final chAcBase = min(annualSalary, acCeiling) * acRate;\r\n'
              '    final chAcSolidarite =\r\n'
              '        annualSalary > acCeiling ? (annualSalary - acCeiling) * acSolidariteRate : 0.0;\r\n'
              '    final chAc = chAcBase + chAcSolidarite;\r\n'
              '\r\n'
              '    // Estimated LPP contribution (employee ~7% of coordinated salary)\r\n'
              '    final coordinatedSalary = max(0.0, min(annualSalary, reg(\'lpp.max_insured_salary\', lppSalaireMax)) - reg(\'lpp.coordination_deduction\', lppDeductionCoordination));\r\n'
              '    final chLpp = coordinatedSalary * 0.07;\r\n'
              '\r\n'
              '    final chTotal = chAvs + chAc + chLpp;\r\n'
              '\r\n'
              '    // ── Foreign charges ──\r\n'
              '    final foreignData = foreignSocialCharges[residenceCountry];\r\n'
              '    final foreignTotalRate = foreignData?[\'total\'] ?? 0.20;\r\n'
              '    final foreignTotal = annualSalary * foreignTotalRate;\r\n'
              '\r\n'
              '    final difference = chTotal - foreignTotal;\r\n'
              '\r\n'
              '    return {\r\n'
              '      \'monthlySalary\': salary,\r\n'
              '      \'annualSalary\': annualSalary,\r\n'
              '      \'residenceCountry\': residenceCountry,\r\n'
              '      \'ch\': {\r\n'
              '        \'avs_ai_apg\': chAvs,\r\n'
              '        \'ac\': chAc,\r\n'
              '        \'lpp\': chLpp,\r\n'
              '        \'total\': chTotal,\r\n'
              '        \'totalRate\': chTotal / annualSalary,\r\n'
              '      },\r\n'
              '      \'foreign\': {\r\n'
              '        \'details\': foreignData ?? {},\r\n'
              '        \'total\': foreignTotal,\r\n'
              '        \'totalRate\': foreignTotalRate,\r\n'
              '      },\r\n'
              '      \'difference\': difference,\r\n'
              '      \'chLessCostly\': difference < 0,\r\n'
              '      \'monthlyDifference\': difference / 12,\r\n'
              '      \'disclaimer\': disclaimer,\r\n'
              '    };\r\n'
              '  }\r\n'
              '\r\n'
              '  // ════════════════════════════════════════════════════════════\r\n'
              '  //  5. SIMULATE FORFAIT FISCAL (lump-sum taxation)\r\n'
              '  // ════════════════════════════════════════════════════════════\r\n'
              '\r\n'
              '  /// Simulate forfait fiscal for a wealthy expatriate.\r\n'
              '  ///\r\n'
              '  /// The forfait is based on living expenses (minimum canton threshold).\r\n'
              '  /// Compared to ordinary taxation on actual income.\r\n'
              '  static Map<String, dynamic> simulateForfaitFiscal({\r\n'
              '    required String canton,\r\n'
              '    required double livingExpenses,\r\n'
              '    required double actualIncome,\r\n'
              '  }) {\r\n'
              '    final cantonMin = forfaitMinimumByCanton[canton];\r\n'
              '\r\n'
              '    if (cantonMin == null) {\r\n'
              '      return {\r\n'
              '        \'canton\': canton,\r\n'
              '        \'cantonNom\': cantonNames[canton] ?? canton,\r\n'
              '        \'eligible\': false,\r\n'
              '        \'abolished\': true,\r\n'
              '        \'note\': \'Le forfait fiscal a ete aboli dans le canton de \'\r\n'
              '            \'${cantonNames[canton] ?? canton}. Il n\\\'est plus possible \'\r\n'
              '            \'d\\\'en beneficier.\',\r\n'
              '        \'disclaimer\': disclaimer,\r\n'
              '      };\r\n'
              '    }\r\n'
              '\r\n'
              '    // Forfait base = max(living expenses, cantonal minimum, federal minimum)\r\n'
              '    final forfaitBase = [livingExpenses, cantonMin, forfaitFederalMinimum]\r\n'
              '        .reduce(max);\r\n'
              '\r\n'
              '    // Forfait tax: apply a simplified effective rate (~25% on forfait base)\r\n'
              '    // This is an approximation; actual rates vary by canton\r\n'
              '    const forfaitTaxRate = 0.25;\r\n'
              '    final forfaitTax = forfaitBase * forfaitTaxRate;\r\n'
              '\r\n'
              '    // Ordinary tax on actual income\r\n'
              '    const ordinaryTaxRate = 0.35; // High earner marginal rate estimate\r\n'
              '    final ordinaryTax = actualIncome * ordinaryTaxRate;\r\n'
              '\r\n'
              '    final savings = ordinaryTax - forfaitTax;\r\n'
              '    final savingsPercent = ordinaryTax > 0 ? savings / ordinaryTax * 100 : 0.0;\r\n'
              '\r\n'
              '    return {\r\n'
              '      \'canton\': canton,\r\n'
              '      \'cantonNom\': cantonNames[canton] ?? canton,\r\n'
