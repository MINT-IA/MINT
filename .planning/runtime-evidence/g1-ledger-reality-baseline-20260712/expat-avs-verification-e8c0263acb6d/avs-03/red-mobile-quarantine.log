              '              : AvsCalculator.rawContributionDurationGapPercent(\r\n'
              '                  ciObservedMissingContributionYears,\r\n'
              '                ),\r\n'
              '    );\r\n'
              '  }\r\n'
              '\r\n'
              '  static void _validateAvsYears(int value, String name) {\r\n'
              '    if (value < 0 || value > fullContributionYears) {\r\n'
              '      throw RangeError.range(value, 0, fullContributionYears, name);\r\n'
              '    }\r\n'
              '  }\r\n'
