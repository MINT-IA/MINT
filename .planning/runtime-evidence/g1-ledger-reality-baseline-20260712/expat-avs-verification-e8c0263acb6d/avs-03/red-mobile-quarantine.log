              '  /// Between table points: linear interpolation within the bracket.\r\n'
              '  /// gapFactor in computeMonthlyRente already handles contribution years.\r\n'
              '  static double renteFromRAMD(double grossAnnualSalary) {\r\n'
              '    if (grossAnnualSalary <= 0) return 0;\r\n'
              '    final table = RegulatorySyncService.getEchelle44();\r\n'
              '    if (grossAnnualSalary <= table.first[0]) return table.first[1];\r\n'
              '    if (grossAnnualSalary >= table.last[0]) return table.last[1];\r\n'
