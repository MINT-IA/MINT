              '\r\n'
              '  /// Assess declared time abroad without turning it into confirmed AVS gaps.\r\n'
              '  ///\r\n'
              '  /// A raw contribution-duration benchmark is exposed only when missing\r\n'
              '  /// contribution years observed on an individual-account statement are\r\n'
              '  /// explicitly supplied. It is not a pension reduction or an official\r\n'
              '  /// scale decision, and no CHF loss is inferred from residence history.\r\n'
              '  static AvsGapAssessment? assessAvsGapOrientation({\r\n'
              '    required bool scenarioStarted,\r\n'
              '    required int yearsAbroad,\r\n'
              '    int? ciObservedMissingContributionYears,\r\n'
              '  }) {\r\n'
              '    if (!scenarioStarted) return null;\r\n'
              '\r\n'
              '    _validateAvsYears(yearsAbroad, \'yearsAbroad\');\r\n'
              '    if (ciObservedMissingContributionYears != null &&\r\n'
              '        (ciObservedMissingContributionYears < 0 ||\r\n'
              '            ciObservedMissingContributionYears > fullContributionYears)) {\r\n'
