              '      }\r\n'
              '    }\r\n'
              '    return table.last[1];\r\n'
              '  }\r\n'
              '\r\n'
              '  /// Apply the LAVS art. 35 / RAVS arts. 53bis-53ter couple contract.\r\n'
              '  ///\r\n'
              '  /// This accepts only person-owned ordinary pensions. Missing or invalid\r\n'
              '  /// legal evidence returns [AvsCoupleCapState.pending] and no complete\r\n'
