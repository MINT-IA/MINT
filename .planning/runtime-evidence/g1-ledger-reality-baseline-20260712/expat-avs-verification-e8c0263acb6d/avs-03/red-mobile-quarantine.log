              '  /// - Gender-aware reference age for AVS21 (LAVS art. 21 al. 1)\r\n'
              '  /// - Child-raising credits (bonifications éducatives) — LAVS art. 29sexies\r\n'
              '  ///\r\n'
              '  /// This illustration does not perform LAVS art. 29quinquies splitting.\r\n'
              '  /// Exact splitting needs year-by-year individual-account histories and a\r\n'
              '  /// statutory trigger; current salaries and marriage duration are rejected as\r\n'
              '  /// a substitute by the couple legal contract.\r\n'
              '  ///\r\n'
              '  /// [isFemale] and [birthYear] are optional — when provided, the\r\n'
              '  /// reference age accounts for AVS21 transitional cohorts (women\r\n'
              '  /// born 1961-1963). When omitted, defaults to 65 (male/unknown).\r\n'
              '  static double computeMonthlyRente({\r\n'
              '    required int currentAge,\r\n'
              '    required int retirementAge,\r\n'
              '    int lacunes = 0,\r\n'
              '    int? anneesContribuees,\r\n'
              '    int? arrivalAge,\r\n'
              '    double grossAnnualSalary = 0,\r\n'
              '    bool? isFemale,\r\n'
              '    int? birthYear,\r\n'
              '    int childRaisingYears = 0,\r\n'
              '    int totalContributionYears = avsDureeCotisationComplete,\r\n'
              '  }) {\r\n'
              '    // Determine gender-aware reference age (AVS21, LAVS art. 21 al. 1)\r\n'
              '    final refAge = (isFemale != null && birthYear != null)\r\n'
              '        ? avsReferenceAgeYears(birthYear: birthYear, isFemale: isFemale)\r\n'
              '        : reg(\'avs.reference_age_men\', avsAgeReferenceHomme.toDouble());\r\n'
              '\r\n'
              '    // 1. Contribution years\r\n'
              '    final fullYears = reg(\'avs.full_contribution_years\', avsDureeCotisationComplete.toDouble()).toInt();\r\n'
              '\r\n'
              '    int currentYears;\r\n'
              '    if (anneesContribuees != null) {\r\n'
              '      currentYears = anneesContribuees;\r\n'
              '    } else if (arrivalAge != null && arrivalAge > 20) {\r\n'
              '      currentYears =\r\n'
              '          (currentAge - arrivalAge).clamp(0, fullYears);\r\n'
              '    } else {\r\n'
              '      currentYears =\r\n'
              '          (currentAge - 20).clamp(0, fullYears);\r\n'
              '    }\r\n'
              '    final futureYears = (retirementAge - currentAge).clamp(0, 50);\r\n'
              '    final totalYears =\r\n'
              '        (currentYears + futureYears).clamp(0, fullYears);\r\n'
              '    final effectiveYears =\r\n'
              '        (totalYears - lacunes).clamp(0, fullYears);\r\n'
              '    final gapFactor = fullYears > 0 ? effectiveYears / fullYears : 0.0;\r\n'
              '\r\n'
              '    // 2. Effective salary (RAMD) with child credits\r\n'
              '    double effectiveSalary = grossAnnualSalary;\r\n'
              '\r\n'
              '    // 2a. Child-raising credits / bonifications éducatives (LAVS art. 29sexies)\r\n'
              '    // Annual credit = 3× minimum annual AVS pension.\r\n'
              '    // Added to RAMD prorated over total contribution years.\r\n'
              '    if (childRaisingYears > 0 && totalContributionYears > 0) {\r\n'
              '      const bonificationAnnuelle = 3 * avsRenteMinMensuelle * 12;\r\n'
              '      final bonificationRAMD =\r\n'
              '          (bonificationAnnuelle * childRaisingYears) / totalContributionYears;\r\n'
