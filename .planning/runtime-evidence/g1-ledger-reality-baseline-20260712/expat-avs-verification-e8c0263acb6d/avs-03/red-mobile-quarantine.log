              '\r\n'
              '  /// Side-by-side tax comparison: CH canton vs target country.\r\n'
              '  static Map<String, dynamic> compareTaxBurden({\r\n'
              '    required double salary,\r\n'
              '    required String canton,\r\n'
              '    required String targetCountry,\r\n'
