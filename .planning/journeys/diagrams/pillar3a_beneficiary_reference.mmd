flowchart TB
  FLAG{"typedLppEvidence AND<br/>documentLppEvidenceEnabled AND<br/>pillar3aBeneficiaryClauseReferenceEnabled"}
  HIDDEN["off or provider loading/unavailable<br/>no card, CTA, intent or provider read"]
  DASH["RetirementDashboardScreen<br/>exact 3a beneficiary consumer"]
  EMPTY["empty<br/>insert authority reference"]
  INTENT["ScanSessionProvider intent FIFO 5<br/>insertion or exact replacement<br/>created -> processing"]
  SCAN["/scan<br/>opaque scanContextId + returnUri only<br/>image/PDF; no text/manual OCR/debug"]
  AUTH["strict institutional authority candidate<br/>document kind + source date + legal year<br/>exact dates or attested regime"]
  REVIEW_SESSION["volatile ScanSessionPayload<br/>raw-free candidate + opaque context"]
  REVIEW["/scan/review<br/>institution metadata + freshness caveat<br/>one declared relation required"]
  LEDGER[("_coach_pillar3a_beneficiary_evidence_v1<br/>serialized secure root<br/>save before publication")]
  RECEIPT["accepted exact receipt<br/>same contract + reference + authority ids<br/>same relationConfirmedAt"]
  BND[("DocumentProvider exact BND tuple<br/>raw-free contract join")]
  RESOLVE{"strict root + exact live BND<br/>canonical presence provenance"}
  KNOWN["knownCurrentDeclared<br/>precise metadata + neutral handoff"]
  CONFIRM["needsConfirmation<br/>relation-only exact-CAS reconfirmation"]
  INACTIVE["inactive<br/>paid/closed or newer canonical false"]
  MISSING["missing or mismatched BND<br/>relink/review; precise metadata hidden"]
  PRESENCE["invalidPresenceProvenance<br/>remove only q_has_3a=false<br/>and provenance.hasPillar3a"]
  INVALID["invalid strict root<br/>purge 3a BND before root reset"]
  BND_RETRY["ledgerAcceptedAwaitingBnd<br/>retry same receipt only<br/>no second Ledger mutation"]
  LIFECYCLE["cancel / route mismatch / flag drift<br/>FIFO eviction / logout / cold restart<br/>purge or localized recovery"]
  BOUNDARY["No beneficiary identity, order, rank/share<br/>no advice, calculation or inferred law"]
  OPEN["Implementation + focused tests GREEN<br/>Opus audits, dossier/PDF and native runtime open<br/>G1 remains NO-GO; G2/G3 forbidden"]

  FLAG -- "false" --> HIDDEN
  FLAG -- "true" --> DASH
  DASH -- "no strict root" --> EMPTY --> INTENT --> SCAN --> AUTH
  AUTH --> REVIEW_SESSION --> REVIEW
  REVIEW -- "accept exact relation" --> LEDGER --> RECEIPT --> BND
  RECEIPT -- "BND failure" --> BND_RETRY --> BND
  LEDGER --> RESOLVE
  BND --> RESOLVE
  RESOLVE -- "current active" --> KNOWN
  RESOLVE -- "uncertain" --> CONFIRM
  RESOLVE -- "paid/closed or canonical false" --> INACTIVE
  RESOLVE -- "BND absent/nonexact" --> MISSING --> INTENT
  RESOLVE -- "presence provenance malformed/future" --> PRESENCE --> RESOLVE
  RESOLVE -- "root malformed" --> INVALID --> EMPTY
  KNOWN --> BOUNDARY
  CONFIRM --> BOUNDARY
  INACTIVE --> BOUNDARY
  MISSING --> BOUNDARY
  LIFECYCLE -. "terminal cleanup" .-> HIDDEN
  SCAN -. "drift/cancel" .-> LIFECYCLE
  REVIEW -. "drift/cancel" .-> LIFECYCLE
  BOUNDARY --> OPEN
