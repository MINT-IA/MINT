+  static void applyRouteFlagsFromMap(Map<String, dynamic> data) {
+    final routes = data['routeFlags'];
+    if (routes is Map) {
+      _routeFlags.clear();
+      routes.forEach((k, v) => _routeFlags[k as String] = v == true);
+    }
   }
 }
 ```
 
