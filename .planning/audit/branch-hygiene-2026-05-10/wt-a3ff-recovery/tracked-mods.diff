-    def _tables_to_text(
-        self, tables: list[list[list[str]]]
-    ) -> str:
-        """Convert table data to searchable text lines."""
-        lines = []
-        for table in tables:
-            for row in table:
-                if row:
-                    line = " | ".join(str(cell) for cell in row if cell)
-                    if line.strip():
-                        lines.append(line)
-        return "\n".join(lines)
