-def _print_current(m: dict[str, int]) -> None:
-    targets_30 = {k: int(v * 0.7) for k, v in m.items()}
-    targets_20 = {k: int(v * 0.8) for k, v in m.items()}
-    print("CLAUDE.md size:")
-    print(_fmt(m, "current"))
-    print(_fmt(targets_30, "-30% tgt"))
