%% G1 BND-02A/BND-02 reality map @ exact SHA 1d022c508.
%% Both tickets are technical GREEN with identical-command, Patrol, Maestro and
%% Claude-wrapper proof. All flags remain default-off; eight publishable
%% external facts and the production descriptor remain missing, so activation
%% and G1 remain NO-GO.
%% Companion: SCREEN_CONTRACTS.md §5.1 and DATA_LEDGER.md BND-02A architecture.
flowchart TD
  START["Real /scan caller<br/>DocumentScanScreen"]
  FLAGS{"All manual-partner kill switches on?<br/>typedLppEvidence AND documentLppEvidenceEnabled<br/>mobile partnerLppAccountabilityEnabled<br/>backend partner_lpp_accountability_enabled"}
  OFF["Default production state: OFF<br/>no partner bytes, receipt or write"]
  OWNER{"À qui appartient<br/>le certificat ?"}
  SELF["Self path<br/>PROV-02 contract"]
  LOCAL{"CoachProfile.conjoint exists?<br/>No HouseholdProvider predicate"}
  NO_PARTNER["Offer self only<br/>never synthesize partner<br/>never force account link"]

  subgraph PRE["Partner pre-acquisition — no picker or bytes"]
    direction TD
    EXT_SOURCE["Production descriptor absent today<br/>notice contract NON PUBLIABLE<br/>8 controller/vendor/legal facts unverified"]
    EXT{"Typed external facts current?<br/>controller/contact + Anthropic role/DPA/regions<br/>transfer/TIA + retention/ZDR + rights + AIPD"}
    BLOCKED["Blocked recovery<br/>no permission, picker, bytes,<br/>receipt, network or ledger write"]
    NOTICE["Versioned concise notice<br/>full notice + rights contact<br/>account-link independent"]
    AUTH{"Acting user JWT current?"}
    LOGIN["Reconnect acting user<br/>resume exact notice step<br/>partner account/link not required"]
    DECLARE{"Explicit represented-authorization<br/>declaration checked?<br/>one-shot LPP only"}
    IDS["Reuse or allocate owner UUIDv4<br/>generate receipt UUIDv4 once"]
    BIND_PENDING[("Strict-secure pending binding<br/>active + pending + shadowed envelope<br/>exact notice/policy/contact/rights<br/>shadow prior active binding")]
    PERMISSION["Generic technical permission<br/>manualPartner: visionExtraction only<br/>typed notice owns transfer disclosure<br/>never persistence365d"]
    PRE_PICK_GATE{"Revalidate external gate<br/>before picker"}
  end

  subgraph LOCAL_FILE["Local file stage"]
    direction TD
    PICKER["Open picker withData=false"]
    CANCEL["Cancel<br/>no receipt"]
    FILE_REF["Selected local path/handle only<br/>NO byte read or hash"]
  end

  subgraph ACCOUNTABILITY["Metadata-only accountability network"]
    direction TD
    RECEIPT[("POST partner_accountability_receipts<br/>JWT actor + keyed owner HMAC<br/>exact ids/versions/purpose<br/>NO PII, IP, SHA, acquisition id or value")]
    RECEIPT_ACTIVE{"Exact receipt active?"}
    RECEIPT_RETRY["Exact-id retry dialog<br/>only typed retryable accountability error<br/>zero document-byte network"]
  end

  subgraph DOCUMENT["Authenticated document path"]
    direction TD
    BYTE_GATE{"Revalidate exact gate + pending binding<br/>before byte/hash, parser and network"}
    READ["Read/prepare exact bytes locally<br/>bind transmitted SHA to volatile authorization"]
    EXTRACT["Direct extract-vision request<br/>document + manualPartner + receiptId<br/>backend atomically consumes receipt<br/>before audit/Anthropic"]
    REVIEW_GATE{"Revalidate exact gate + pending binding<br/>at public review handoff"}
    REVIEW["Review canonical facts<br/>owner immutable + source date<br/>caisse rate visibly quarantined"]
    SAVE["Verify pending + exact owner<br/>save whole secure root<br/>activate same binding<br/>then publish profile"]
    IMPACT["Scan impact<br/>CTA to RetirementDashboard"]
  end

  TERMINAL["First authority drift = terminal<br/>exactly one receipt DELETE attempt + rollback<br/>restore shadowed active binding<br/>suppress later callback/fallback/review"]
  ROLLBACK["Safe local rollback<br/>erase pending binding<br/>restore explicitly shadowed active binding"]

  subgraph COLD["Cold status and real BND-02 consumer"]
    direction TD
    VERIFY{"Exact owner binding + backend<br/>receipt current after restart?"}
    ACTIVE["Select receipt-bound certificate facts<br/>MintStateEngine → ForecasterService<br/>one projection recompute"]
    DASH["RetirementDashboard<br/>visible changed ranged result<br/>active expiry/status"]
    PARTIAL["partial+ask<br/>exclude receipt-bound facts<br/>never cached GREEN or CHF 0"]
    INVALIDATE["expired, revoked, erased or mismatch<br/>remove receipt-bound certificate facts<br/>recompute exactly once"]
    RESTORE{"Independent userInput fact exists?"}
    MANUAL["Restore it automatically<br/>mark à confirmer"]
    ASK["One named-impact Ask<br/>current partner LPP capital<br/>Je ne sais pas + dismiss"]
    RETRY["Retry exact receipt status<br/>never create duplicate receipt"]
    RIGHTS["Exact accepted privacy contact<br/>and rights channel remain visible"]
  end

  QUARANTINE["fundReturnRateRatio<br/>retained in evidence root<br/>never conjoint.rendementCaisse<br/>never calculator input"]
  DIRECT["direct_partner_confirmation deferred<br/>no CTA, route or endpoint facade"]
  PG_GREEN["PostgreSQL technical gate GREEN @ fde00b18c<br/>Alembic round-trip + actor FOR UPDATE<br/>one-shot/idempotency + both delete race orders"]
  ACCEPTANCE["BND-02 + BND-02A TECHNICAL GREEN @ 1d022c508<br/>ACTIVATION + G1 NO-GO<br/>8 external facts remain unproven"]

  START --> FLAGS
  FLAGS -->|off — current production| OFF
  FLAGS -->|explicitly on| OWNER
  OWNER -->|self| SELF
  OWNER -->|manualPartner candidate| LOCAL
  LOCAL -->|no| NO_PARTNER
  LOCAL -->|yes| EXT
  EXT_SOURCE -. "missing today" .-> EXT
  EXT -->|missing or stale| BLOCKED
  EXT -->|current| NOTICE
  NOTICE --> AUTH
  AUTH -->|no| LOGIN
  LOGIN --> NOTICE
  AUTH -->|yes| DECLARE
  DECLARE -->|unchecked or cancel| BLOCKED
  DECLARE -->|checked| IDS
  IDS --> BIND_PENDING
  BIND_PENDING --> PERMISSION
  PERMISSION -->|denied or cancel| ROLLBACK
  PERMISSION --> PRE_PICK_GATE
  PRE_PICK_GATE -->|stale| ROLLBACK
  PRE_PICK_GATE -->|current| PICKER
  PICKER -->|cancel| ROLLBACK
  PICKER -->|file chosen| FILE_REF
  FILE_REF --> RECEIPT
  RECEIPT --> RECEIPT_ACTIVE
  RECEIPT_ACTIVE -->|typed retryable error only| RECEIPT_RETRY
  RECEIPT_ACTIVE -->|terminal or unexpected error| TERMINAL
  RECEIPT_RETRY -->|same logical ids| RECEIPT
  RECEIPT_RETRY -->|cancel| TERMINAL
  RECEIPT_ACTIVE -->|active| BYTE_GATE
  BYTE_GATE -->|drift| TERMINAL
  BYTE_GATE -->|exact| READ
  READ --> EXTRACT
  EXTRACT --> REVIEW_GATE
  REVIEW_GATE -->|drift| TERMINAL
  REVIEW_GATE -->|exact| REVIEW
  REVIEW -. "caisse fact excluded" .-> QUARANTINE
  REVIEW -->|confirm| SAVE
  SAVE -->|whole-root + activation success| IMPACT
  SAVE -->|failure with compensation| PARTIAL
  IMPACT --> VERIFY
  VERIFY -->|active + exact owner| ACTIVE
  ACTIVE --> DASH
  DASH --> RIGHTS
  VERIFY -->|loading, offline or unverifiable| PARTIAL
  VERIFY -->|expired, revoked, erased or mismatch| INVALIDATE
  INVALIDATE --> RESTORE
  PARTIAL --> RESTORE
  RESTORE -->|yes| MANUAL
  RESTORE -->|no| ASK
  MANUAL --> DASH
  ASK --> DASH
  PARTIAL --> RETRY
  RETRY --> VERIFY
  PARTIAL --> RIGHTS
  TERMINAL --> ROLLBACK
  NOTICE -. "future distinct design only" .-> DIRECT
  OFF -. "activation gate" .-> ACCEPTANCE
  PG_GREEN -. "technical proof only" .-> ACCEPTANCE
  RIGHTS -. "acceptance gate" .-> ACCEPTANCE

  classDef gate fill:#FFF4D6,stroke:#8A6414,color:#3B2B08;
  classDef blocked fill:#FDECEC,stroke:#A43A3A,color:#5C1717;
  classDef durable fill:#E6F4F1,stroke:#176B5B,color:#103F36;
  classDef consumer fill:#EAF0FF,stroke:#315DA8,color:#18355F;
  classDef deferred fill:#F1F1F1,stroke:#777,color:#333,stroke-dasharray: 5 5;

  class FLAGS,OWNER,LOCAL,EXT,AUTH,DECLARE,PRE_PICK_GATE,RECEIPT_ACTIVE,BYTE_GATE,REVIEW_GATE,VERIFY,RESTORE gate;
  class OFF,BLOCKED,TERMINAL,ROLLBACK,PARTIAL,INVALIDATE,ACCEPTANCE blocked;
  class IDS,BIND_PENDING,RECEIPT,SAVE durable;
  class ACTIVE,DASH,MANUAL,ASK,RETRY,RIGHTS consumer;
  class DIRECT,QUARANTINE,EXT_SOURCE deferred;
  class PG_GREEN durable;
