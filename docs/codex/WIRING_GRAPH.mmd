%% ============================================================================
%% WIRING_GRAPH.mmd — MINT navigation + data-flow graph (Codex-executable)
%% ----------------------------------------------------------------------------
%% Baseline note: file:line refs target apps/mobile & services/backend at 255373b,
%% which are UNCHANGED on this branch (only docs/codex/ added since) -> valid at HEAD.
%% Status: normative. Hand-grounded against the REAL code at commit 255373b.
%% Every node/edge below is transcribed from apps/mobile/lib/app.dart (router +
%% MultiProvider tree) with line numbers. Companion: DATA_LEDGER.md,
%% SCREEN_CONTRACTS.md (exhaustive per-route contracts). Conflict order:
%% rules.md > CLAUDE.md > this file.
%% .
%% This file is a SINGLE valid Mermaid flowchart. The machine-checkable
%% INVARIANTS are at the bottom as %% comments (I-1..I-9), each citing the real
%% file a script/Codex must assert against.
%% ============================================================================

flowchart TB

  %% ==========================================================================
  %% PART A — PROVIDER / DATA-FLOW GRAPH (apps/mobile/lib/app.dart:1411-1531)
  %% The spine + the islands. Solid arrow = live listen/recompute edge that
  %% EXISTS in code. Dashed arrow = REQUIRED bridge that is MISSING today.
  %% ==========================================================================
  subgraph SPINE["PROVIDER / DATA-FLOW (source of truth)"]
    direction TB
    CPP["CoachProfileProvider<br/>app.dart:1428<br/>SINGLE write path:<br/>mergeAnswers / applySaveFact / updateProfile"]
    MSP["MintStateProvider<br/>app.dart:1466 (ProxyProvider)<br/>builds MintUserState (read-model)"]
    NWS["NotificationsWiringService<br/>app.dart:1504 (ProxyProvider)"]
    PERSIST[("SharedPreferences<br/>key: wizard_answers_v2<br/>report_persistence_service.dart")]
    BACKEND[("backend ProfileModel.data<br/>save_fact 35-key allowlist<br/>coach_chat.py:924")]

    CPP -- "notifies (ProxyProvider.update)" --> MSP
    CPP -- "notifies (ProxyProvider.update)" --> NWS
    CPP <-- "load/persist" --> PERSIST
    CPP -. "fire-and-forget sync" .-> BACKEND

    %% Islands: plain ChangeNotifierProvider, NOT bridged to the recompute.
    BUDGET["BudgetProvider<br/>app.dart:1419 — ISLAND"]
    HOUSE["HouseholdProvider<br/>app.dart:1427 — ISLAND"]
    TIMELINE["TimelineProvider<br/>app.dart:1484 — ISLAND"]
    DOCS["DocumentProvider<br/>app.dart:1425 — ISLAND"]
    PLAN["FinancialPlanProvider<br/>app.dart:1479 — ISLAND"]
    DEADP["ProfileProvider<br/>app.dart:1418 — LEGACY (4 hasDebt consumers, migrate then delete)"]

    BUDGET -. "MISSING bridge -> recompute" .-> MSP
    HOUSE  -. "MISSING sync -> CoachProfile.conjoint" .-> CPP
    TIMELINE -. "MISSING bridge (re-fetches 4 services)" .-> MSP
    DOCS   -. "MISSING merge into ledger" .-> CPP
    PLAN   -. "MISSING bridge -> recompute" .-> MSP
  end

  %% ==========================================================================
  %% PART B — NAVIGATION GRAPH (apps/mobile/lib/app.dart:301-1340)
  %% Nodes = live screens (have a builder). Dashed edges = redirect routes
  %% (legacy shims -> canonical). Every node reachable from a shell tab, hub,
  %% or an explicit deep-link/settings entry point; no orphan; no dead-end
  %% EXCEPT the flagged red traps, which this graph exists to eliminate.
  %% ==========================================================================
  subgraph NAV["NAVIGATION"]
    direction TB

    %% ---- Entry / auth (RouteScope public) ----
    LAND["/ landing"]
    subgraph AUTH["auth"]
      LOGIN["/auth/login"]; REG["/auth/register"]; FORGOT["/auth/forgot-password"]
      VEMAIL["/auth/verify-email"]; VERIFY["/auth/verify"]
    end
    ANON["/anonymous/chat (3 free msgs)"]

    %% ---- Persistent 4-tab shell (StatefulShellRoute) ----
    subgraph SHELL["4-tab shell (StatefulShellRoute.indexedStack)"]
      HOME["/home (Aujourd'hui)"]; ARGENT["/mon-argent"]
      COACH["/coach/chat"]; EXPLORE["/explore"]
    end

    %% ---- Explorer hubs ----
    subgraph HUBS["/explore hubs"]
      H_RET["/explore/retraite"]; H_FAM["/explore/famille"]; H_TRA["/explore/travail"]
      H_LOG["/explore/logement"]; H_FIS["/explore/fiscalite"]; H_PAT["/explore/patrimoine"]
      H_SAN["/explore/sante"]
    end

    %% ---- Leaf screens by domain (live builders) ----
    subgraph RET["retraite / prevoyance"]
      RETR["/retraite"]; RVC["/rente-vs-capital"]; RACHAT["/rachat-lpp"]; EPL["/epl"]
      DECAI["/decaissement"]; LIBRE["/libre-passage"]; SUCC["/succession"]; CHIST["/coach/history"]
    end
    subgraph FIS["fiscalite"]
      P3A["/pilier-3a"]; C3A["/3a-deep/comparator"]; RR3A["/3a-deep/real-return"]
      SW3A["/3a-deep/staggered-withdrawal"]; RETRO3A["/3a-retroactif"]; FISCAL["/fiscal"]
    end
    subgraph IMMO["logement"]
      HYPO["/hypotheque"]; AMORT["/mortgage/amortization"]; EPLC["/mortgage/epl-combined"]
      IMPR["/mortgage/imputed-rental"]; SARON["/mortgage/saron-vs-fixed"]; HSALE["/life-event/housing-sale"]
      LVP["/arbitrage/location-vs-propriete"]
    end
    subgraph FAM["famille"]
      DIV["/divorce"]; MAR["/mariage"]; NAI["/naissance"]; CONC["/concubinage"]
      DON["/life-event/donation"]; DECES["/life-event/deces-proche"]
    end
    subgraph TRA["travail / independants"]
      UNEMP["/unemployment"]; FJOB["/first-job"]; EXPAT["/expatriation"]; JOBC["/simulator/job-comparison"]
      INDEP["/segments/independant"]; IAVS["/independants/avs"]; IIJM["/independants/ijm"]
      I3A["/independants/3a"]; IDIV["/independants/dividende-salaire"]; ILPP["/independants/lpp-volontaire"]
      FRONT["/segments/frontalier"]; GGAP["/segments/gender-gap"]
    end
    subgraph SAN["sante"]
      INVAL["/invalidite"]; DINS["/disability/insurance"]; DSELF["/disability/self-employed"]
      LAMAL["/assurances/lamal"]; COV["/assurances/coverage"]
    end
    subgraph PAT["patrimoine / budget / dette"]
      BUD["/budget"]; BSET["/budget/setup"]; CDEBT["/check/debt"]; DRATIO["/debt/ratio"]
      DHELP["/debt/help"]; DREPAY["/debt/repayment"]; ABILAN["/arbitrage/bilan"]
      AALLOC["/arbitrage/allocation-annuelle"]; DCANT["/life-event/demenagement-cantonal"]
      CBENCH["/cantonal-benchmark"]
    end
    subgraph DATA["collection / documents / report"]
      SCAN["/scan"]; SCANAVS["/scan/avs-guide"]
      SREVIEW["/scan/review<br/>builds from extra (:903)"]:::trap
      SIMPACT["/scan/impact<br/>builds from extra (:916)"]:::trap
      DBLOCK["/data-block/:type<br/>DataBlockEnrichmentScreen"]
      DOCLIST["/documents"]; DOCID["/documents/:id"]; BANKIMP["/bank-import"]
      RAPPORT["/rapport<br/>depends on extra (:974)"]:::trap
      CONF["/confidence"]
    end
    subgraph MISC["misc / education / couple / settings (deep-link + settings entries)"]
      COUPLE["/couple"]; CACCEPT["/couple/accept"]; EHUB["/education/hub"]; ETHEME["/education/theme/:id"]
      SCOMP["/simulator/compound"]; SLEAS["/simulator/leasing"]; SCRED["/simulator/credit"]
      LANGUE["/settings/langue"]; ABOUT["/about"]; ADMINR["/admin/routes"]; TL["/timeline"]
    end

    %% ---- Redirect shims (legacy -> canonical). Dashed = redirect. ----
    R_TOOLS["/tools (redirect :1185)"]:::redir
    R_PORT["/portfolio (redirect :1189)"]:::redir
    R_ASK["/ask-mint (:1180)"]:::redir
    R_ADVIS["/advisor* (:1311-1319)"]:::redir
    R_ONB["/onboarding/* (:1222-1336)"]:::redir
    R_OB["/open-banking* (:1282-1298)"]:::redir
    R_LEGACY["25+ legacy redirects<br/>/retirement /coach/* /lpp-deep/* /household*<br/>/report* /score-reveal /achievements /profile"]:::redir

    %% ---- Real navigation edges ----
    LAND --> REG --> VEMAIL --> COACH
    LAND --> ANON
    LAND --> LOGIN --> HOME
    FORGOT --> LOGIN
    VERIFY --> HOME

    HOME --- ARGENT --- COACH --- EXPLORE
    EXPLORE --> H_RET & H_FAM & H_TRA & H_LOG & H_FIS & H_PAT & H_SAN
    H_RET --> RETR & RVC & RACHAT & EPL & DECAI & LIBRE & SUCC
    H_FIS --> P3A & C3A & RR3A & SW3A & RETRO3A & FISCAL
    H_LOG --> HYPO & AMORT & EPLC & IMPR & SARON & HSALE & LVP
    H_FAM --> MAR & DIV & NAI & CONC & DON & DECES & SUCC
    H_TRA --> FJOB & JOBC & INDEP & UNEMP & EXPAT & FRONT & GGAP
    H_TRA --> IAVS & IIJM & I3A & IDIV & ILPP
    H_SAN --> INVAL & DINS & DSELF & LAMAL & COV
    H_PAT --> ABILAN & AALLOC & DON & DECES & DCANT & CBENCH
    ARGENT --> BUD --> BSET
    ARGENT --> CDEBT --> DRATIO & DHELP & DREPAY
    COACH --> DBLOCK
    COACH --> SCAN --> SCANAVS
    SCAN --> SREVIEW --> SIMPACT
    COACH --> RAPPORT --> CONF
    RETR --> RVC & RACHAT & DECAI
    HOME --> TL
    ARGENT --> DOCLIST --> DOCID

    %% ---- Reachability for MISC/couple/education/settings (I-7) ----
    %% couple invite lands via family hub; education hub via coach; the three
    %% standalone simulators via the money tab; settings/about/admin via home
    %% (profile drawer). Each is entered from a shell tab or hub, not orphaned.
    H_FAM --> COUPLE --> CACCEPT
    COACH --> EHUB --> ETHEME
    ARGENT --> SCOMP & SLEAS & SCRED
    HOME --> LANGUE & ABOUT & ADMINR

    %% ---- Redirect resolution edges (no dangling shim) ----
    R_TOOLS -. redirect .-> COACH
    R_PORT -. redirect .-> HOME
    R_ASK -. redirect .-> COACH
    R_ADVIS -. redirect .-> COACH
    R_ONB -. redirect .-> COACH
    R_OB -. redirect .-> ARGENT
    R_LEGACY -. redirect .-> HOME
  end

  classDef trap fill:#5a1111,stroke:#ff5555,color:#fff,stroke-width:2px;
  classDef redir fill:#333,stroke:#888,color:#ccc,stroke-dasharray:4 3;

