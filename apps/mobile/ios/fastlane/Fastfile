require "base64"
require_relative "build_number"

# MINT iOS — Fastlane configuration
# Usage:
#   cd apps/mobile/ios
#   bundle exec fastlane beta
#
# Required environment variables (set as GitHub Secrets):
#   APP_STORE_CONNECT_API_KEY_ID      — App Store Connect API Key ID
#   APP_STORE_CONNECT_ISSUER_ID       — App Store Connect Issuer ID
#   APP_STORE_CONNECT_API_KEY_CONTENT — App Store Connect API Key (.p8 content)
#   MATCH_PASSWORD                    — Password to decrypt certificates repo
#   MATCH_GIT_URL                     — Git repo URL for match certificates
#   KEYCHAIN_PASSWORD                 — Temporary keychain password (CI only)

default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    key_id = [
      ENV["APP_STORE_CONNECT_API_KEY_ID"],
      ENV["APP_STORE_KEY_ID"],
      ENV["ASC_KEY_ID"],
    ].map { |v| v.to_s.strip }.find { |v| !v.empty? }

    issuer_id = [
      ENV["APP_STORE_CONNECT_ISSUER_ID"],
      ENV["APP_STORE_ISSUER_ID"],
      ENV["ASC_ISSUER_ID"],
    ].map { |v| v.to_s.strip }.find { |v| !v.empty? }

    raw_key_content = [
      ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      ENV["APP_STORE_CONNECT_API_KEY"],
      ENV["APP_STORE_CONNECT_PRIVATE_KEY"],
      ENV["ASC_API_KEY_CONTENT"],
    ].map { |v| v.to_s.strip }.find { |v| !v.empty? }

    UI.user_error!("Missing App Store key id (APP_STORE_CONNECT_API_KEY_ID)") if key_id.to_s.empty?
    UI.user_error!("Missing App Store issuer id (APP_STORE_CONNECT_ISSUER_ID)") if issuer_id.to_s.empty?
    UI.user_error!("Missing App Store private key content (APP_STORE_CONNECT_API_KEY_CONTENT)") if raw_key_content.to_s.empty?

    # Accept either plain .p8 content or base64-encoded .p8, and normalize escaped newlines.
    normalized_key_content = raw_key_content.gsub('\n', "\n")
    unless normalized_key_content.include?("-----BEGIN PRIVATE KEY-----")
      begin
        decoded = Base64.strict_decode64(normalized_key_content)
        normalized_key_content = decoded
      rescue ArgumentError
        UI.user_error!("APP_STORE_CONNECT_API_KEY_CONTENT must be a .p8 key or base64-encoded .p8 key")
      end
    end

    unless normalized_key_content.include?("-----BEGIN PRIVATE KEY-----") &&
           normalized_key_content.include?("-----END PRIVATE KEY-----")
      UI.user_error!("APP_STORE_CONNECT_API_KEY_CONTENT does not contain a valid .p8 private key")
    end

    # ── 1. App Store Connect API auth (no interactive login) ──
    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: normalized_key_content,
      is_key_content_base64: false,
      in_house: false,
    )

    # ── 2. Setup CI keychain (handles everything automatically) ──
    setup_ci if ENV["CI"]

    # ── 3. Fetch signing certificates + profiles ──
    match_params = {
      type: "appstore",
      app_identifier: "ch.mint.app",
      git_url: ENV["MATCH_GIT_URL"],
      api_key: api_key,
      readonly: true,
    }
    # NOTE: Do NOT pass git_basic_authorization here. It triggers match's internal
    # -c http.extraheader which is overridden by macOS credential helpers on GitHub
    # Actions runners. Instead, credentials are in ~/.git-credentials (set up by
    # the "Configure git credentials" workflow step). Match clones using the
    # system credential store, which works reliably.
    match(match_params)

    # ── 4. Resolve build number dynamically ──
    # TestFlight reserves in-flight uploads before latest processed catches up.
    # Use pubspec as a floor, TestFlight+margin as a guard, and a UTC timestamp
    # as the normal CI candidate so repeated staging uploads do not need manual
    # pubspec bumps.
    pubspec_path = File.expand_path("../../pubspec.yaml", __dir__)
    pubspec_content = File.read(pubspec_path)
    begin
      pubspec_build_number = MintBuildNumber.parse_pubspec_build_number(pubspec_content)
    rescue ArgumentError => e
      UI.user_error!(e.message)
    end
    UI.message("Pubspec build number: #{pubspec_build_number}")

    latest_tf = latest_testflight_build_number(api_key: api_key)
    UI.message("TestFlight latest processed build number: #{latest_tf}")
    ci_candidate = MintBuildNumber.ci_timestamp_candidate
    effective_build_number = MintBuildNumber.next_build_number(
      pubspec_build_number: pubspec_build_number,
      latest_testflight_build_number: latest_tf,
      ci_candidate: ci_candidate,
    )
    UI.message("CI timestamp build candidate: #{ci_candidate}")
    UI.message("Effective build number: #{effective_build_number}")

    increment_build_number(
      build_number: effective_build_number,
      xcodeproj: "Runner.xcodeproj",
    )

    # ── 5. Configure manual code signing (use Match profile) ──
    update_code_signing_settings(
      use_automatic_signing: false,
      team_id: "7F5UDGYS5H",
      code_sign_identity: "iPhone Distribution",
      profile_name: "match AppStore ch.mint.app",
      path: "Runner.xcodeproj",
    )

    # ── 6. Build the Flutter IPA ──
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "ch.mint.app" => "match AppStore ch.mint.app",
        },
      },
      output_directory: "../build/ios",
      output_name: "Mint.ipa",
    )

    # ── 7. Upload to TestFlight ──
    # The upload + auto-submit-for-beta-review is a single fastlane action,
    # but Apple's beta review queue accepts ONLY ONE in-flight build per train
    # (e.g. version 2.9.0). When a previous build is still in review, the
    # auto-submit raises Spaceship::UnexpectedResponse and the WHOLE action
    # exits non-zero — even though the binary IS already in App Store Connect.
    # That makes our CI flap as failure on what is in fact a successful upload.
    #
    # Strategy: try the full submission first. If the « Another build is in
    # review » error is raised, log the manual ASC step and exit clean.
    # The binary is already in App Store Connect at this point (altool
    # uploads it BEFORE auto-submit runs) — the operator just needs to
    # manually submit it to Beta Testeurs from the ASC UI once the
    # previous build clears Apple's review queue.
    #
    # Historical bug (fixed 2026-05-21 by `fix/fastlane-testflight-retry-idempotency`) :
    # the previous version of this block re-tried with
    # `upload_to_testflight(skip_submission: true)` on the assumption that
    # altool would fast-path a duplicate upload. It does NOT — altool
    # rejects the duplicate with `-19232 ENTITY_ERROR.ATTRIBUTE.INVALID.DUPLICATE`,
    # making every staging promote a false-positive workflow failure even
    # though the binary was already in ASC. Removing the retry fixes the
    # workflow exit code without losing the manual-step message.
    begin
      upload_to_testflight(
        api_key: api_key,
        skip_waiting_for_build_processing: false,
        distribute_external: true,
        groups: ["Beta Testeurs"],
        changelog: ENV["TESTFLIGHT_CHANGELOG"] || `git log -1 --pretty=format:"%s"`.strip,
      )
    rescue => e
      msg = e.message.to_s
      if msg.include?("Another build is in review") ||
         msg.include?("already in beta review")
        UI.important("✅ Binary uploaded to App Store Connect successfully.")
        UI.important("⚠️  Auto-submit to « Beta Testeurs » skipped: previous build of this train is still in Apple's review queue.")
        UI.important("👉  Manual step: once the previous build clears review, open App Store Connect → TestFlight → Beta Testeurs group → submit this build for review.")
        # Exit clean — the binary IS in ASC, no retry needed. Re-uploading
        # would trip altool's duplicate-bundle-version guard.
      else
        raise
      end
    end
  end

  desc "Register devices + refresh profiles"
  lane :refresh_profiles do
    match(
      type: "appstore",
      app_identifier: "ch.mint.app",
      git_url: ENV["MATCH_GIT_URL"],
      force_for_new_devices: true,
    )
  end

  desc "Initialize Match certificates (run once locally)"
  lane :setup_match do
    raw = ENV["APP_STORE_CONNECT_API_KEY_CONTENT"]
    normalized = raw.gsub('\n', "\n")
    unless normalized.include?("-----BEGIN PRIVATE KEY-----")
      normalized = Base64.strict_decode64(normalized)
    end

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: normalized,
      is_key_content_base64: false,
      in_house: false,
    )

    match(
      type: "appstore",
      app_identifier: "ch.mint.app",
      team_id: "7F5UDGYS5H",
      api_key: api_key,
      git_url: ENV["MATCH_GIT_URL"],
    )
  end
end
