{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mint-next-storyboard-v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "goal",
    "generated_at",
    "phase_authority",
    "design_authority",
    "field_ownership",
    "novice_validation",
    "entry_scene",
    "happy_path",
    "branches",
    "decisions",
    "scenes"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "goal": {
      "$ref": "#/$defs/goal"
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "phase_authority": {
      "$ref": "#/$defs/pin"
    },
    "design_authority": {
      "$ref": "#/$defs/design"
    },
    "field_ownership": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/owner"
      }
    },
    "novice_validation": {
      "$ref": "#/$defs/novice"
    },
    "entry_scene": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "happy_path": {
      "type": "array",
      "minItems": 5,
      "maxItems": 7,
      "items": {
        "type": "string"
      }
    },
    "branches": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missing_data",
        "refusal",
        "zero_choice"
      ],
      "properties": {
        "missing_data": {
          "$ref": "#/$defs/path"
        },
        "refusal": {
          "$ref": "#/$defs/path"
        },
        "zero_choice": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 7,
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/decision"
      }
    }
  },
  "$defs": {
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "promise"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "promise": {
          "type": "string"
        }
      }
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "status_anchor"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status_anchor": {
          "type": "string"
        }
      }
    },
    "file_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_revision",
        "authority",
        "historical_context"
      ],
      "properties": {
        "approved_revision": {
          "type": "string"
        },
        "authority": {
          "$ref": "#/$defs/role_pin"
        },
        "historical_context": {
          "$ref": "#/$defs/role_pin"
        }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "path",
        "anchor"
      ],
      "properties": {
        "field": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "anchor": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "novice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "protocol",
        "observations"
      ],
      "properties": {
        "status": {
          "const": "not_run"
        },
        "protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "readers_required",
            "questions",
            "time_limit_seconds"
          ],
          "properties": {
            "readers_required": {
              "const": 2
            },
            "questions": {
              "const": 5
            },
            "time_limit_seconds": {
              "const": 60
            }
          }
        },
        "observations": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "path": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "chapter",
        "title",
        "summary",
        "user_sees",
        "user_understands",
        "primary_action",
        "data",
        "architecture",
        "transitions",
        "target",
        "observations",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "chapter": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "user_sees": {
          "type": "string"
        },
        "user_understands": {
          "type": "string"
        },
        "primary_action": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reads",
            "writes"
          ],
          "properties": {
            "reads": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "writes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "architecture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "route",
            "state",
            "contract"
          ],
          "properties": {
            "route": {
              "type": "string"
            },
            "state": {
              "type": "string"
            },
            "contract": {
              "type": "string"
            }
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event",
              "destination"
            ],
            "properties": {
              "event": {
                "type": "string"
              },
              "destination": {
                "type": "string"
              }
            }
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "intention_oracle",
            "observation_oracle"
          ],
          "properties": {
            "intention_oracle": {
              "type": "string"
            },
            "observation_oracle": {
              "type": "string"
            }
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code_refs",
            "runtime_receipts",
            "exposure_receipts"
          ],
          "properties": {
            "code_refs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/code_ref"
              }
            },
            "runtime_receipts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/runtime_receipt"
              }
            },
            "exposure_receipts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/exposure_receipt"
              }
            }
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_path",
        "sha256",
        "criterion",
        "result"
      ],
      "properties": {
        "receipt_path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "criterion": {
          "type": "string"
        },
        "result": {
          "enum": [
            "pass",
            "fail"
          ]
        }
      }
    },
    "code_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "symbol"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "symbol": {
          "type": "string"
        }
      }
    },
    "runtime_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "product_sha",
        "platform",
        "scene_id"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "product_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "platform": {
          "enum": [
            "ios",
            "android"
          ]
        },
        "scene_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        }
      }
    },
    "exposure_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "product_sha"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "product_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "decision",
        "rationale",
        "rejected",
        "revisited_when"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "rejected": {
          "type": "string",
          "minLength": 1
        },
        "revisited_when": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "role_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "role"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "role": {
          "enum": [
            "authority",
            "historical_context"
          ]
        }
      }
    }
  }
}
